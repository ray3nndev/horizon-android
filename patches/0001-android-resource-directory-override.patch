+        // Android hosts embed the engine in the launcher process, so there is no
+        // standalone horizon executable whose parent can locate bundled resources.
+        // The host supplies this directory before entering the engine. Desktop
+        // launchers retain the historical executable-sibling lookup.
+        let sibling = if let Some(path) = std::env::var_os("HORIZON_RESOURCES_DIR") {
+            let path = PathBuf::from(path);
+            if !path.join("horizon-resources.json").is_file() {
+                return Err(format!(
+                    "HORIZON_RESOURCES_DIR {} has no horizon-resources.json",
+                    path.display()
+                )
+                .into());
+            }
+            path
+        } else {
+            std::env::current_exe()?
+                .parent()
+                .ok_or("missing executable directory")?
+                .join("resources")
+        };
